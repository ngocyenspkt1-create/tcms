{
  "name": "tcms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "save": "node scripts/git-save.mjs",
    "db:create": "node --env-file-if-exists=.env.local scripts/database/create.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/database/check.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/database/migrate.mjs",
    "db:grant": "node --env-file-if-exists=.env.local scripts/database/grant-runtime.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/database/seed.mjs",
    "db:setup": "node scripts/database/setup.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/database/run-powershell.mjs backup",
    "db:restore": "node --env-file-if-exists=.env.local scripts/database/run-powershell.mjs restore",
    "test:security": "node --test tests/security/*.test.ts",
    "test:routes": "node --test tests/routes/*.test.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/vie": "^1.0.0",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

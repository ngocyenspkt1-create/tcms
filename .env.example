# Không đưa giá trị bí mật thật vào Git. Khi chạy local, chủ dự án tự tạo các tệp này ngoài thư mục mã nguồn.
DATABASE_URL_FILE=C:/secure/tcms/dev-database-url.txt
# Hoặc chỉ ở local DEV: DATABASE_URL=postgresql://tcms_dev_app:password@localhost:5432/tcms_dev
# Tài khoản owner chỉ dùng cho migration/seed, không dùng khi chạy web.
MIGRATION_DATABASE_URL=postgresql://tcms_dev_owner:password@localhost:5432/tcms_dev
# Dùng một lần để npm run db:create; không cần cho ứng dụng runtime.
POSTGRES_ADMIN_URL=postgresql://postgres:password@localhost:5432/postgres
AUTH_SECRET_FILE=C:/secure/tcms/dev-auth-secret.txt
TCMS_FIELD_ENCRYPTION_KEY_FILE=C:/secure/tcms/dev-field-key.base64

# Chỉ bỏ comment ba biến OIDC khi đã có cấu hình IdP thật hoặc khi tắt DEV auth.
# AUTH_OIDC_CLIENT_SECRET_FILE=C:/secure/tcms/dev-oidc-client-secret.txt
# AUTH_OIDC_ISSUER=https://idp.example.internal/realms/company
# AUTH_OIDC_CLIENT_ID=tcms-dev
AUTH_TRUST_HOST=true
TCMS_DB_SSL=require
TCMS_DB_POOL_MAX=10

# Chỉ dùng khi DEV chưa nối được màn hình SSO; tuyệt đối không bật ở production.
DEV_AUTH_ENABLED=true
# Chọn một trong: dev-admin, dev-manager, dev-supervisor, dev-viewer
DEV_AUTH_SUBJECT=dev-manager
DEV_AUTH_MFA=true

# PDF Import AI: khóa chỉ tồn tại phía server, ưu tiên đọc từ tệp bí mật ngoài repository.
TCMS_PDF_AI_PROVIDER=openai
TCMS_PDF_AI_MODEL=gpt-5.6
OPENAI_API_KEY_FILE=C:/secure/tcms/dev-openai-api-key.txt
# Chỉ bật fallback local khi chấp nhận thời gian OCR lâu hơn; đây không phải luồng chính.
TCMS_PDF_LOCAL_OCR_FALLBACK=true
